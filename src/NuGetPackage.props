<Project>

    <PropertyGroup>
        <Platforms>AnyCPU;x64;x86</Platforms>

        <Authors>Snowberry Software</Authors>
        <AssemblyVersion>2.1.0.0</AssemblyVersion>
        <VersionPrefix>$(AssemblyVersion)</VersionPrefix>
        <!-- <VersionSuffix>alpha</VersionSuffix> -->

        <IsPackable>true</IsPackable>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>globbing, glob pattern, glob pattern matching, pattern matching</PackageTags>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <Copyright>Copyright © $([System.DateTime]::Now.Year) Snowberry Software</Copyright>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <PackageProjectUrl>https://github.com/snowberry-software/Snowberry.Globbing</PackageProjectUrl>

        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/snowberry-software/Snowberry.Globbing.git</RepositoryUrl>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Publish the repository URL in the built .nupkg (in the NuSpec <Repository> element) -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>

        <!-- Embed source files that are not tracked by the source control manager in the PDB -->
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- Recommended: Embed symbols containing Source Link in the main file (exe/dll) -->
        <DebugType>embedded</DebugType>

        <!-- Ship IntelliSense XML and enforce the documentation diagnostics configured in
        .editorconfig -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Report the .editorconfig code-style rules on every build, so CI fails on style errors -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- StyleCop checks the documentation; only the rules enabled in .editorconfig run -->
    <ItemGroup>
        <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
        <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)StyleCop.globalconfig" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
    </ItemGroup>

    <!-- Deterministic Builds -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TF_BUILD)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- SourceLink -->
    <ItemGroup>
        <!-- For GitHub -->
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>
</Project>